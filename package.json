{
  "name": "nodenotificationsbot",
  "version": "0.1.0",
  "description": "Telegram bot that reports Bitcoin Core initial block download (IBD) progress",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/cli/migrate.ts",
    "rpc:auth": "tsx src/cli/rpcAuth.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "fix": "eslint --fix .",
    "check": "npm run typecheck && eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@grammyjs/auto-retry": "~2.0.2",
    "better-sqlite3": "~13.0.3",
    "grammy": "~1.46.0",
    "pino": "~10.4.0",
    "yaml": "~2.9.1",
    "zod": "~4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@types/better-sqlite3": "~9.6.0",
    "@types/node": "~26.6.4",
    "@typescript/native": "npm:typescript@~7.0.2",
    "eslint": "~10.14.0",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.7",
    "prettier": "~3.9.10",
    "tsx": "~4.23.15",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "typescript-eslint": "~8.72.1",
    "vitest": "~5.1.0"
  }
}
